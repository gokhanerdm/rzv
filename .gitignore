# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# paralel calisma kopyalari (git worktree) - her biri kendi node_modules'unu kurar
/.claude/worktrees/
# kopyalarin kendi sunucu baslatma dosyalari - asil projeye karismasin
KOPYA_SUNUCU.*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude - kisisel notlar
CLAUDE.local.md
